  "orderDdl": "CREATE TABLE `ticket_order` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '订单主键',\n  `order_no` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '唯一订单号',\n  `user_id` bigint unsigned NOT NULL COMMENT '下单用户',\n  `session_id` bigint unsigned NOT NULL COMMENT '订单所属唯一场次',\n  `status` varchar(16) NOT NULL DEFAULT 'PENDING' COMMENT 'PENDING 待支付，PAID 已支付，CANCELLED 取消，EXPIRED 超时',\n  `total_amount_cents` bigint NOT NULL COMMENT '下单时应付金额快照，人民币分',\n  `idempotency_operation` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务操作域，如 CREATE_ORDER',\n  `idempotency_key` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '用户提交的幂等键',\n  `request_hash` binary(32) NOT NULL COMMENT '规范化请求参数 SHA-256，检测同键异参',\n  `expires_at` datetime(6) NOT NULL COMMENT '支付截止时间 UTC',\n  `paid_at` datetime(6) DEFAULT NULL COMMENT '支付完成时间 UTC',\n  `created_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) COMMENT '创建时间 UTC',\n  `updated_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6) COMMENT '更新时间 UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uk_order_no` (`order_no`),\n  UNIQUE KEY `uk_order_idempotency` (`user_id`,`idempotency_operation`,`idempotency_key`),\n  UNIQUE KEY `uk_order_id_session` (`id`,`session_id`),\n  UNIQUE KEY `uk_order_id_user` (`id`,`user_id`),\n  KEY `idx_order_user_created` (`user_id`,`created_at`,`id`),\n  KEY `idx_order_expiry` (`status`,`expires_at`,`id`),\n  KEY `idx_order_session` (`session_id`),\n  KEY `idx_order_user_session_status` (`user_id`,`session_id`,`status`,`id`),\n  KEY `idx_order_admin_created` (`created_at`,`id`),\n  CONSTRAINT `fk_order_session` FOREIGN KEY (`session_id`) REFERENCES `activity_session` (`id`),\n  CONSTRAINT `fk_order_user` FOREIGN KEY (`user_id`) REFERENCES `user_account` (`id`),\n  CONSTRAINT `ck_order_amount` CHECK ((`total_amount_cents` >= 0)),\n  CONSTRAINT `ck_order_expiry` CHECK ((`expires_at` > `created_at`)),\n  CONSTRAINT `ck_order_paid_time` CHECK ((((`status` in (_utf8mb4'PAID',_utf8mb4'REFUNDED')) and (`paid_at` is not null)) or ((`status` not in (_utf8mb4'PAID',_utf8mb4'REFUNDED')) and (`paid_at` is null)))),\n  CONSTRAINT `ck_order_status` CHECK ((`status` in (_utf8mb4'PENDING',_utf8mb4'PAID',_utf8mb4'CANCELLED',_utf8mb4'EXPIRED',_utf8mb4'REFUNDED')))\n) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='票务订单及幂等记录'",
