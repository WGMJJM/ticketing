# 复制为 .env 后填写本地凭据；启动脚本仅支持 KEY=value，不执行文件内容。
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7-alpine
RABBITMQ_IMAGE=rabbitmq:4.1-management-alpine
# missing 优先复用本地镜像；never 完全禁止拉取。
IMAGE_PULL_POLICY=missing
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=ticketing
MYSQL_USER=ticketing
MYSQL_PASSWORD=replace_with_local_app_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=ticketing
RABBITMQ_PASSWORD=replace_with_local_mq_password
SERVER_PORT=8080
# 仅本地HTTP联调设为false；生产HTTPS保持true（后端默认true）。
SESSION_COOKIE_SECURE=false
# 一次性创建数据库管理员，启用时提供合法用户名及至少16位密码，创建后关闭。
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
