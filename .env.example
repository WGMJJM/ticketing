# 复制为 .env 后填写本地凭据；启动脚本仅支持 KEY=value，不执行文件内容。
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7-alpine
RABBITMQ_IMAGE=rabbitmq:4.1-management-alpine
# missing 优先复用本地镜像；never 完全禁止拉取。
IMAGE_PULL_POLICY=missing
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=ticketing
MYSQL_USER=ticketing
MYSQL_PASSWORD=replace_with_local_app_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 登录/注册/下单/候补保护默认开启。每个部署使用独立命名空间及随机Base64密钥（解码32至128字节）。
# 不复用电子票签名密钥；多应用实例必须配置相同密钥与命名空间。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_KEY_SECRET=
RATE_LIMIT_NAMESPACE=default
RATE_LIMIT_CSRF_SESSION_IP_LIMIT=120
RATE_LIMIT_CSRF_SESSION_IP_WINDOW_SECONDS=60
# 默认直连忽略转发头。TRUSTED_PROXY仅用于已清洗X-Forwarded-For且网络隔离的显式代理。
CLIENT_ADDRESS_MODE=DIRECT
CLIENT_ADDRESS_TRUSTED_PROXIES=
CLIENT_ADDRESS_MAX_FORWARDED_HOPS=8
CLIENT_ADDRESS_MAX_FORWARDED_HEADER_LENGTH=1024
RATE_LIMIT_UNAVAILABLE_RETRY_SECONDS=1
REDIS_CONNECT_TIMEOUT=500ms
REDIS_COMMAND_TIMEOUT=1s
RATE_LIMIT_LOGIN_IP_LIMIT=60
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_ACCOUNT_IP_LIMIT=10
RATE_LIMIT_LOGIN_ACCOUNT_IP_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_IP_LIMIT=10
RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=600
# 验证码IP、邮箱冷却和滚动日窗口共用一次多KEY原子限流。
RATE_LIMIT_EMAIL_CODE_IP_LIMIT=10
RATE_LIMIT_EMAIL_CODE_IP_WINDOW_SECONDS=600
RATE_LIMIT_EMAIL_CODE_COOLDOWN_SECONDS=60
RATE_LIMIT_EMAIL_CODE_DAILY_LIMIT=5
# 真实SMTP未配置时保持关闭，公开注册明确返回暂不可用，不提供假发送。
REGISTRATION_EMAIL_ENABLED=false
# 独立于限流和电子票密钥，随机Base64密钥，解码32至128字节。
REGISTRATION_CODE_SECRET=
REGISTRATION_NAMESPACE=default
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_SSL_ENABLED=false
# 单应用实例启动时有界分页回填，达到容量则不启用负判断优化。
REGISTRATION_BLOOM_ENABLED=true
REGISTRATION_BLOOM_EXPECTED_ACCOUNTS=1000000
REGISTRATION_BLOOM_FALSE_POSITIVE_RATE=0.01
RATE_LIMIT_ORDER_USER_LIMIT=30
RATE_LIMIT_ORDER_USER_WINDOW_SECONDS=10
RATE_LIMIT_WAITLIST_USER_LIMIT=10
RATE_LIMIT_WAITLIST_USER_WINDOW_SECONDS=60
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=ticketing
RABBITMQ_PASSWORD=replace_with_local_mq_password
SERVER_PORT=8080
# 订单集中配置，用户跨票档共享场次限额。
ORDER_SESSION_LIMIT=4
ORDER_PAYMENT_WINDOW_MINUTES=15
# 普通购票先可靠受理；容量1至10000，排队5至900秒，超时与正式订单支付截止独立。
PURCHASE_CAPACITY=200
PURCHASE_QUEUE_SECONDS=120
PURCHASE_IN_FLIGHT_WINDOW=64
PURCHASE_CONFIRM_TIMEOUT_MS=3000
PURCHASE_RECOVERY_SECONDS=10
PURCHASE_RECOVERY_BATCH_SIZE=100
PURCHASE_SCAN_DELAY_MS=1000
PURCHASE_JOBS_ENABLED=true
PURCHASE_MESSAGING_ENABLED=true
# 通用Outbox发布器同时服务购票与候补，业务通道轮转认领。
OUTBOX_JOBS_ENABLED=true
# MySQL可靠超时扫描，默认开启；每批1至500，每次处理完再等待指定毫秒数。
ORDER_EXPIRY_ENABLED=true
ORDER_EXPIRY_SCAN_DELAY_MS=30000
ORDER_EXPIRY_BATCH_SIZE=100
# 候补最长等待时间，实际不晚于票档停售；消息投递与数据库补偿默认开启。
WAITLIST_MAX_WAIT_MINUTES=60
WAITLIST_MESSAGING_ENABLED=true
WAITLIST_JOBS_ENABLED=true
WAITLIST_OUTBOX_POLL_MS=1000
# 单轮健康发布上限1至100，故障后结束当轮，下一轮按退避条件重试。
WAITLIST_OUTBOX_BATCH_SIZE=100
WAITLIST_COMPENSATION_POLL_MS=60000
# 电子票签名密钥映射JSON，例如版本号映射至随机生成的Base64密钥（解码至少32字节）。不得使用示例固定值。
TICKET_CREDENTIAL_KEYS=
TICKET_CREDENTIAL_CURRENT_VERSION=1
CHECKIN_OPENS_BEFORE_MINUTES=60
# 历史补票仅显式开启，逐单事务、有界扫描；完成受控补票后关闭。
TICKET_BACKFILL_ENABLED=false
TICKET_BACKFILL_BATCH_SIZE=100
TICKET_BACKFILL_SCAN_DELAY_MS=30000
# 仅本地HTTP联调设为false；生产HTTPS保持true（后端默认true）。
SESSION_COOKIE_SECURE=true
# 一次性创建数据库管理员，启用时提供合法用户名及至少16位密码，创建后关闭。
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
# 公开目录缓存，与普通购票真实库存预扣相互独立。
CATALOG_CACHE_ENABLED=true
CATALOG_CACHE_MAXIMUM_ENTRIES=2000
CATALOG_CACHE_LOCAL_SECONDS=15
CATALOG_CACHE_REDIS_SECONDS=120
CATALOG_CACHE_NEGATIVE_SECONDS=5
CATALOG_CACHE_CONCURRENT_LOADS=8
CATALOG_CACHE_LOAD_WAIT_MS=100
## V9历史库仅在停写、备份、额度审计通过后单次启用，迁移完成后撤销。
ORDER_QUOTA_MIGRATION_APPROVED=false
# Outbox有界在途窗口；保留原批量与租约配置，默认值以隔离对照验收为准。
WAITLIST_OUTBOX_IN_FLIGHT_WINDOW=16

# 仅购票命令消费者，候补监听器保持原并发。
PURCHASE_CONSUMER_CONCURRENCY=2
PURCHASE_CONSUMER_PREFETCH=1

# 场次取消善后：每单独立事务，失败有界退避后进入人工待办。
ORDER_AFTERCARE_ENABLED=true
ORDER_AFTERCARE_SCAN_DELAY_MS=10000
ORDER_AFTERCARE_BATCH_SIZE=100
ORDER_AFTERCARE_MAX_ATTEMPTS=5
ORDER_AFTERCARE_RETRY_DELAY_SECONDS=30
# 候补续跑队列满时由MySQL补偿；启动时首先扫描，不依赖内存队列保存事实。
WAITLIST_COMPENSATION_INITIAL_DELAY_MS=1000
WAITLIST_CONTINUATION_QUEUE_CAPACITY=64
