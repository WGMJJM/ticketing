<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="票务购票端到端性能测试" enabled="true">
      <stringProp name="TestPlan.comments">独立测试库使用。订单 TPS 由 verify-orders.sql 核对；仅成功交易样本参与端到端 P95。</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="用户定义变量" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP 默认值" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量" enabled="true">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.domain">${__P(host,127.0.0.1)}</stringProp>
        <stringProp name="HTTPSampler.port">${__P(port,18080)}</stringProp>
        <stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">${__P(connectTimeoutMs,3000)}</stringProp>
        <stringProp name="HTTPSampler.response_timeout">${__P(responseTimeoutMs,10000)}</stringProp>
      </ConfigTestElement>
      <hashTree/>
      <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="每线程会话 Cookie" enabled="true">
        <collectionProp name="CookieManager.cookies"/>
        <boolProp name="CookieManager.clearEachIteration">true</boolProp>
        <boolProp name="CookieManager.controlledByThread">true</boolProp>
        <stringProp name="CookieManager.policy">standard</stringProp>
      </CookieManager>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="独立账号购票负载" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="按账号 CSV 驱动" enabled="true">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(threads,1)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampUpSeconds,1)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(durationSeconds,60)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.delayedStart">false</boolProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="每次交易分配新的独立账号" enabled="true">
          <stringProp name="filename">${__P(usersCsv,)}</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="variableNames">username,password</stringProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="quotedData">true</boolProp>
          <boolProp name="recycle">false</boolProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="准备登录前 CSRF" enabled="true">
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量" enabled="true">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
            <stringProp name="HTTPSampler.path">/api/v1/auth/csrf</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
            <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="清理上笔交易变量并生成本轮幂等键" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script"><![CDATA[
def batch = props.getProperty('batchId', '')
if (!(batch ==~ /[A-Za-z0-9_-]{8,60}/)) {
    throw new IllegalArgumentException('必须通过 -JbatchId 提供本轮唯一批次标识')
}
def threadNo = ctx.getThreadNum() + 1
def iteration = vars.getIteration()
vars.put('testBatch', batch)
vars.put('idempotencyKey', "jmeter-${batch}-${threadNo}-${iteration}-${java.util.UUID.randomUUID().toString().replace('-', '')}")
['csrfToken', 'csrfHeader', 'requestId', 'orderId', 'terminalStatus', 'failureCode', 'purchaseOutcome'].each { vars.put(it, '') }
vars.put('pollContinue', 'false')
vars.put('loginOk', 'false')
              ]]></stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="读取登录前 CSRF" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script"><![CDATA[
try {
    def payload = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    def data = payload?.data
    if (prev.getResponseCode() == '200' && data?.token && data?.headerName) {
        vars.put('csrfToken', data.token.toString())
        vars.put('csrfHeader', data.headerName.toString())
    } else {
        prev.setSuccessful(false)
        prev.setResponseMessage('CSRF 初始化失败')
    }
} catch (Exception ignored) {
    prev.setSuccessful(false)
    prev.setResponseMessage('CSRF 响应格式无效')
}
              ]]></stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Session 登录" enabled="true">
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="登录表单" enabled="true">
              <collectionProp name="Arguments.arguments">
                <elementProp name="username" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.value">${username}</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp><stringProp name="Argument.name">username</stringProp>
                </elementProp>
                <elementProp name="password" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.value">${password}</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp><stringProp name="Argument.name">password</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.path">/api/v1/auth/login</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
            <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="登录 CSRF 与表单头" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="csrf" elementType="Header"><stringProp name="Header.name">${csrfHeader}</stringProp><stringProp name="Header.value">${csrfToken}</stringProp></elementProp>
                <elementProp name="content-type" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/x-www-form-urlencoded</stringProp></elementProp>
                <elementProp name="accept" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="确认登录成功" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script"><![CDATA[
def ok = prev.getResponseCode() == '200'
vars.put('loginOk', Boolean.toString(ok))
if (!ok) {
    prev.setSuccessful(false)
    prev.setResponseMessage('测试账号登录失败')
}
              ]]></stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="登录成功后读取认证后的 CSRF" enabled="true">
            <stringProp name="IfController.condition">${__groovy(vars.get('loginOk') == 'true')}</stringProp>
            <boolProp name="IfController.evaluateAll">true</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="刷新登录后 CSRF" enabled="true">
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp>
              <stringProp name="HTTPSampler.path">/api/v1/auth/csrf</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
              <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
            </HTTPSamplerProxy>
            <hashTree>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="读取登录后 CSRF" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="script"><![CDATA[
try {
    def payload = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    def data = payload?.data
    if (prev.getResponseCode() == '200' && data?.token && data?.headerName) {
        vars.put('csrfToken', data.token.toString())
        vars.put('csrfHeader', data.headerName.toString())
    } else {
        prev.setSuccessful(false)
        prev.setResponseMessage('登录后 CSRF 刷新失败')
        vars.put('loginOk', 'false')
    }
} catch (Exception ignored) {
    prev.setSuccessful(false)
    prev.setResponseMessage('登录后 CSRF 响应格式无效')
    vars.put('loginOk', 'false')
}
                ]]></stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>
            <IfController guiclass="IfControllerPanel" testclass="IfController" testname="凭据就绪后执行购票" enabled="true">
              <stringProp name="IfController.condition">${__groovy(vars.get('loginOk') == 'true' &amp;&amp; vars.get('csrfToken') != null &amp;&amp; !vars.get('csrfToken').isEmpty())}</stringProp>
              <boolProp name="IfController.evaluateAll">true</boolProp>
              <boolProp name="IfController.useExpression">true</boolProp>
            </IfController>
            <hashTree>
              <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="订单创建端到端" enabled="true">
                <boolProp name="TransactionController.parent">false</boolProp>
                <boolProp name="TransactionController.includeTimers">true</boolProp>
              </TransactionController>
              <hashTree>
                <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="购票申请受理" enabled="true">
                  <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
                  <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="购票请求 JSON" enabled="true">
                    <collectionProp name="Arguments.arguments">
                      <elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"skuId":"${__P(skuId,)}","quantity":1}</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp><stringProp name="Argument.name"></stringProp></elementProp>
                    </collectionProp>
                  </elementProp>
                  <stringProp name="HTTPSampler.path">/api/v1/orders</stringProp>
                  <stringProp name="HTTPSampler.method">POST</stringProp>
                  <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
                  <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
                  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                  <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
                </HTTPSamplerProxy>
                <hashTree>
                  <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="购票请求 CSRF 与幂等头" enabled="true">
                    <collectionProp name="HeaderManager.headers">
                      <elementProp name="csrf" elementType="Header"><stringProp name="Header.name">${csrfHeader}</stringProp><stringProp name="Header.value">${csrfToken}</stringProp></elementProp>
                      <elementProp name="content-type" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
                      <elementProp name="accept" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
                      <elementProp name="idempotency" elementType="Header"><stringProp name="Header.name">Idempotency-Key</stringProp><stringProp name="Header.value">${idempotencyKey}</stringProp></elementProp>
                    </collectionProp>
                  </HeaderManager>
                  <hashTree/>
                  <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="记录端到端起点" enabled="true">
                    <stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="scriptLanguage">groovy</stringProp>
                    <stringProp name="script"><![CDATA[
vars.put('purchaseStartMillis', Long.toString(System.currentTimeMillis()))
vars.put('pollContinue', 'false')
vars.put('purchaseOutcome', 'SUBMIT_PENDING')
                    ]]></stringProp>
                  </JSR223PreProcessor>
                  <hashTree/>
                  <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="校验受理响应并提取 requestId" enabled="true">
                    <stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="scriptLanguage">groovy</stringProp>
                    <stringProp name="script"><![CDATA[
try {
    def payload = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    def data = payload?.data
    if (prev.getResponseCode() == '202' && data?.requestId?.toString()) {
        vars.put('requestId', data.requestId.toString())
        vars.put('pollContinue', 'true')
        vars.put('purchaseOutcome', 'IN_PROGRESS')
    } else {
        def code = payload?.code?.toString() ?: "HTTP_${prev.getResponseCode()}"
        vars.put('failureCode', code.replaceAll('[^A-Za-z0-9_.-]', '_').take(64))
        vars.put('purchaseOutcome', prev.getResponseCode() == '202' ? 'INVALID_ACCEPTANCE' : 'SUBMIT_FAILED')
        prev.setSuccessful(false)
        prev.setResponseMessage(vars.get('failureCode'))
    }
} catch (Exception ignored) {
    vars.put('purchaseOutcome', 'INVALID_ACCEPTANCE')
    vars.put('failureCode', "HTTP_${prev.getResponseCode()}")
    prev.setSuccessful(false)
    prev.setResponseMessage('受理响应格式无效')
}
                    ]]></stringProp>
                  </JSR223PostProcessor>
                  <hashTree/>
                </hashTree>
                <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="按固定间隔轮询至终态或截止时间" enabled="true">
                  <stringProp name="WhileController.condition">${__groovy(vars.get('pollContinue') == 'true')}</stringProp>
                </WhileController>
                <hashTree>
                  <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="查询购票申请状态" enabled="true">
                    <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
                    <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp>
                    <stringProp name="HTTPSampler.path">/api/v1/purchase-requests/${requestId}</stringProp>
                    <stringProp name="HTTPSampler.method">GET</stringProp>
                    <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
                    <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
                    <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                    <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
                  </HTTPSamplerProxy>
                  <hashTree>
                    <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="轮询间隔" enabled="true">
                      <stringProp name="ConstantTimer.delay">${__P(pollIntervalMs,250)}</stringProp>
                    </ConstantTimer>
                    <hashTree/>
                    <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="状态查询头" enabled="true">
                      <collectionProp name="HeaderManager.headers"><elementProp name="accept" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp></collectionProp>
                    </HeaderManager>
                    <hashTree/>
                    <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="提取终态并设置购票结果" enabled="true">
                      <stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="scriptLanguage">groovy</stringProp>
                      <stringProp name="script"><![CDATA[
try {
    def payload = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    def data = payload?.data
    if (prev.getResponseCode() != '200' || data == null) {
        vars.put('purchaseOutcome', 'POLL_FAILED')
        vars.put('failureCode', "HTTP_${prev.getResponseCode()}")
        vars.put('pollContinue', 'false')
        prev.setSuccessful(false)
        prev.setResponseMessage('状态查询失败')
    } else {
        def state = data.status?.toString() ?: ''
        vars.put('terminalStatus', state)
        if (state == 'SUCCEEDED' && data.orderId?.toString() ==~ /[0-9]+/) {
            vars.put('orderId', data.orderId.toString())
            vars.put('purchaseOutcome', 'SUCCEEDED')
            vars.put('failureCode', '')
            vars.put('pollContinue', 'false')
        } else if (state in ['FAILED', 'EXPIRED']) {
            def code = data.failureCode?.toString() ?: state
            vars.put('failureCode', code.replaceAll('[^A-Za-z0-9_.-]', '_').take(64))
            vars.put('purchaseOutcome', state)
            vars.put('pollContinue', 'false')
            prev.setSuccessful(false)
            prev.setResponseMessage(vars.get('failureCode'))
        } else if (System.currentTimeMillis() - Long.parseLong(vars.get('purchaseStartMillis')) >= Long.parseLong(props.getProperty('maxPollSeconds', '60')) * 1000L) {
            vars.put('purchaseOutcome', 'TIMEOUT')
            vars.put('failureCode', 'CLIENT_POLL_TIMEOUT')
            vars.put('pollContinue', 'false')
            prev.setSuccessful(false)
            prev.setResponseMessage('客户端轮询超时')
        } else {
            vars.put('pollContinue', 'true')
        }
    }
} catch (Exception ignored) {
    vars.put('purchaseOutcome', 'POLL_RESPONSE_INVALID')
    vars.put('failureCode', 'POLL_RESPONSE_INVALID')
    vars.put('pollContinue', 'false')
    prev.setSuccessful(false)
    prev.setResponseMessage('状态响应格式无效')
}
                      ]]></stringProp>
                    </JSR223PostProcessor>
                    <hashTree/>
                  </hashTree>
                </hashTree>
              </hashTree>
            </hashTree>
          </hashTree>
        </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
